# ---- Contact form (Resend) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=info@kjmanagementaccountingsolutions.com
CONTACT_FROM_EMAIL="KJ Website <website@kjmanagementaccountingsolutions.com>"

# ---- Google reviews ----
# Option A: Featurable (free, unlimited reviews, no billing). Create a widget at
# https://featurable.com and paste the widget ID here.
NEXT_PUBLIC_FEATURABLE_WIDGET_ID=

# Option B: Google Places API (New). Returns a MAXIMUM of 5 reviews.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Secret Vercel Cron sends as `Authorization: Bearer <value>` when it hits
# /api/cron/refresh-reviews once a month. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://kjmanagementaccountingsolutions.com
